#!/bin/bash

# Ask for version number (or use VERSION.txt if available)
default_version=$(cat VERSION.txt 2>/dev/null || echo "1.0.0")
read -p "Enter the version number [$default_version]: " version
version="${version:-$default_version}"

release_folder="releases/curd-$version"
linux_folder="$release_folder/linux"
android_folder="$release_folder/android"

# Ensure required directories exist
mkdir -p "$linux_folder" "$android_folder"

# Build Linux binaries
echo "Building Linux binaries..."
bash Build/buildlinux

# Move the Linux binaries to the release folder
if [ -f "curd-linux-x86_64" ]; then
    mv curd-linux-x86_64 "$linux_folder"
else
    echo "Linux x86_64 build failed. Please check Build/buildlinux-x86_64."
    exit 1
fi

if [ -f "curd-linux-arm64" ]; then
    mv curd-linux-arm64 "$linux_folder"
else
    echo "Linux arm64 build failed. Please check Build/buildlinux-arm64."
    exit 1
fi

# Build Android binary
echo "Building Android ARM64 binary..."
bash Build/buildandroid-arm64
if [ -f "curd-android-arm64" ]; then
    mv curd-android-arm64 "$android_folder"
else
    echo "Android build failed. Please check Build/buildandroid-arm64."
    exit 1
fi

echo "Release build completed successfully in $release_folder."
